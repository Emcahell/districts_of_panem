---
import { ClientRouter } from 'astro:transitions';

import '../styles/global.css';

interface Props {
  title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="google-site-verification" content="Kqn6Ox__Uoas4eT48MEqZkIMSCUtnNmeR_rWtMADVdw" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content="A comprehensive guide to the districts of Panem, featuring detailed information about each district's industry, victors, and role in the Hunger Games universe." />
		<meta name="keywords" content="Panem, districts of Panem, The Hunger Games, Los Juegos del Hambre, distritos de panem" />
		<meta property="og:title" content="Districts of Panem">
		<meta property="og:description" content="A comprehensive guide to the districts of Panem, featuring detailed information about each district's industry, victors.">
		<meta property="og:type" content="website">
		<meta property="og:url" content="https://districts-of-panem.vercel.app">
		<meta property="og:site_name" content="The Hunger Games">
		<meta name="author" content="Emcahell" />
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite", 
				"name": "The Hunger Games",
				"url": "https://districts-of-panem.vercel.app",
				"description": "A comprehensive guide to the districts of Panem, featuring detailed information about each district's industry, victors.",
				"potentialAction": {
          "@type": "SearchAction",
          "target": "https://districts-of-panem.vercel.app/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
			}
			</script>
		<title>Districts of Panem | {title}</title>
		<ClientRouter />
	</head>
	<body class="bg-background">
		<slot />
	</body>
</html>
